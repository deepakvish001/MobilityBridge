<section class="trip-card" aria-label="@Title"><header><h3>@Title</h3></header>@if(Value is not null){<strong>@Value</strong>}@if(!string.IsNullOrWhiteSpace(Detail)){<p>@Detail</p>}@ChildContent</section>
@code{[Parameter,EditorRequired]public string Title{get;set;}="trip card";[Parameter]public string? Value{get;set;}[Parameter]public string? Detail{get;set;}[Parameter]public RenderFragment? ChildContent{get;set;}}
